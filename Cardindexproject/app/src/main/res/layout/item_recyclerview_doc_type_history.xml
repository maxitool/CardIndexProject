<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/linearLayoutDocument"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fio_colon_ru"
            android:textStyle="bold|italic"
            android:textColor="@color/text_black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Петрович Петр Петров"
            android:textStyle="bold"
            android:textColor="@color/text_black"
            android:textSize="22sp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_of_birth_colon_ru"
            android:textStyle="italic"
            android:textColor="@color/text_black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24.04.2000"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/complaints_colon_ru"
            android:textStyle="italic"
            android:textColor="@color/text_black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewShortProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="пульпит 27"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_treatment_colon_ru"
            android:textStyle="italic"
            android:textColor="@color/text_black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textDateTreatment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24.04.2000"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/to_server_colon_ru"
            android:textStyle="italic"
            android:textColor="@color/text_black_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewSentServerState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="не отправлено"
            android:textColor="@color/text_black"
            android:textSize="18sp"
            android:layout_marginLeft="8dp"/>

    </LinearLayout>

    <Spinner
        android:id="@+id/spinnerNoteActions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/icon_more"
        android:foreground="?android:attr/selectableItemBackground"/>


</LinearLayout>